# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Server-Side Database with service_role secret key)
# Obtain your secret key (service_role) in Supabase Project Settings > API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"

# SECURITY: ADMIN PIN FOR /control-panel
# Definir PIN numérico ou alfanumérico para acesso do proprietário
ADMIN_PIN="1234"

# SECURITY: ADMIN SESSION SECRET (HMAC-SHA256 Token Signing for Stateless/Serverless Sessions)
# Chave secreta aleatória longa usada para assinar criptograficamente os tokens de login (ex: gere com crypto.randomBytes(32).toString('hex'))
ADMIN_SESSION_SECRET="your-strong-random-session-secret-at-least-32-chars"

